{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.nabd.cross": {
      "initial_state": "off",
      "states": {
        "off": {
          "transitions": [
            {
              "stand": "variable.nabd_tp_cross > 0.5 && !query.is_sneaking && !query.is_swimming && !query.is_crawling && !query.is_gliding && !query.is_sleeping"
            },
            {
              "sneak": "variable.nabd_tp_cross > 0.5 && query.is_sneaking"
            },
            {
              "low": "variable.nabd_tp_cross > 0.5 && (query.is_swimming || query.is_crawling || query.is_gliding)"
            }
          ]
        },
        "stand": {
          "particle_effects": [
            {
              "effect": "nabd_cross",
              "pre_effect_script": "variable.eye = 1.62;"
            }
          ],
          "transitions": [
            {
              "off": "variable.nabd_tp_cross < 0.5 || !(!query.is_sneaking && !query.is_swimming && !query.is_crawling && !query.is_gliding && !query.is_sleeping)"
            }
          ]
        },
        "sneak": {
          "particle_effects": [
            {
              "effect": "nabd_cross",
              "pre_effect_script": "variable.eye = 1.27;"
            }
          ],
          "transitions": [
            {
              "off": "variable.nabd_tp_cross < 0.5 || !query.is_sneaking"
            }
          ]
        },
        "low": {
          "particle_effects": [
            {
              "effect": "nabd_cross",
              "pre_effect_script": "variable.eye = 0.4;"
            }
          ],
          "transitions": [
            {
              "off": "variable.nabd_tp_cross < 0.5 || !(query.is_swimming || query.is_crawling || query.is_gliding)"
            }
          ]
        }
      }
    }
  }
}