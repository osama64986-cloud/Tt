{
 "format_version": "1.10.0",
 "particle_effect": {
  "description": {
   "identifier": "ab:streak",
   "basic_render_parameters": {
    "material": "particles_add",
    "texture": "textures/particle/ab_orb"
   }
  },
  "components": {
   "minecraft:emitter_rate_instant": {
    "num_particles": "math.max(1, variable.count)"
   },
   "minecraft:emitter_lifetime_once": {
    "active_time": 0.05
   },
   "minecraft:emitter_shape_sphere": {
    "radius": 0.15,
    "direction": "outwards"
   },
   "minecraft:particle_lifetime_expression": {
    "max_lifetime": "variable.life * math.random(0.6, 1.0)"
   },
   "minecraft:particle_initial_speed": "variable.speed * math.random(0.6, 1.2)",
   "minecraft:particle_motion_dynamic": {
    "linear_drag_coefficient": 7
   },
   "minecraft:particle_appearance_billboard": {
    "size": [
     "variable.size * 0.09",
     "variable.size * (1.0 - variable.particle_age / variable.particle_lifetime)"
    ],
    "facing_camera_mode": "direction_y",
    "uv": {
     "texture_width": 16,
     "texture_height": 16,
     "uv": [
      0,
      0
     ],
     "uv_size": [
      16,
      16
     ]
    }
   },
   "minecraft:particle_appearance_tinting": {
    "color": [
     "variable.color.r",
     "variable.color.g",
     "variable.color.b",
     "1.0 - variable.particle_age / variable.particle_lifetime"
    ]
   }
  }
 }
}