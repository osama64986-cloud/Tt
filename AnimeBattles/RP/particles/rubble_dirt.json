{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ab:rubble_dirt",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/blocks/dirt"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, variable.count)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "math.max(0.2, variable.radius)",
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.9, 2.2)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life * math.random(0.75, 1.25)"
      },
      "minecraft:particle_initial_speed": "variable.speed * math.random(0.6, 1.2)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-400, 400)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -24,
          0
        ],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.08,
        "coefficient_of_restitution": 0.25,
        "collision_drag": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (0.5 + variable.particle_random_2 * 0.6)",
          "variable.size * (0.5 + variable.particle_random_2 * 0.6)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            "math.floor(variable.particle_random_3 * 11)",
            "math.floor(variable.particle_random_4 * 11)"
          ],
          "uv_size": [
            5,
            5
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "math.clamp(4 * (1 - variable.particle_age / variable.particle_lifetime), 0, 1)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}