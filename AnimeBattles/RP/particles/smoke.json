{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ab:smoke",
      "basic_render_parameters": { "material": "particles_alpha", "texture": "textures/particle/ab_orb" }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": "math.max(1, variable.count)" },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_box": { "offset": [0, 1.0, 0], "half_dimensions": ["0.45 + variable.radius", "1.0 + variable.radius", "0.45 + variable.radius"], "direction": [0, 1, 0] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "variable.life * math.random(0.7, 1.0)" },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_motion_dynamic": { "linear_acceleration": [0, 2.2, 0], "linear_drag_coefficient": 1.2 },
      "minecraft:particle_appearance_billboard": {
        "size": ["variable.size * (0.6 + variable.particle_age / variable.particle_lifetime)", "variable.size * (0.6 + variable.particle_age / variable.particle_lifetime)"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [0, 0], "uv_size": [16, 16] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["variable.color.r", "variable.color.g", "variable.color.b", "variable.alpha * (1.0 - variable.particle_age / variable.particle_lifetime)"]
      }
    }
  }
}
