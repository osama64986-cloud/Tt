{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ab:aura",
      "basic_render_parameters": { "material": "particles_add", "texture": "textures/particle/ab_orb" }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": "math.max(1, variable.count)" },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_box": { "offset": [0, 0.9, 0], "half_dimensions": [0.45, 0.9, 0.45], "direction": [0, 1, 0] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "variable.life * math.random(0.7, 1.0)" },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_motion_dynamic": { "linear_acceleration": [0, 3, 0], "linear_drag_coefficient": 1.5 },
      "minecraft:particle_appearance_billboard": {
        "size": ["variable.size * 0.35", "variable.size"],
        "facing_camera_mode": "lookat_y",
        "uv": { "texture_width": 16, "texture_height": 16, "uv": [0, 0], "uv_size": [16, 16] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": ["variable.color.r", "variable.color.g", "variable.color.b", "1.0 - variable.particle_age / variable.particle_lifetime * 0.85"]
      }
    }
  }
}
