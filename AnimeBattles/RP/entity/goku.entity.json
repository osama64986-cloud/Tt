{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "ab:goku",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "base": "textures/entity/goku/base",
    "ssj": "textures/entity/goku/ssj",
    "ssj3": "textures/entity/goku/ssj3",
    "ssb": "textures/entity/goku/ssb",
    "ui": "textures/entity/goku/ui"
   },
   "geometry": {
    "base": "geometry.ab.goku_base",
    "ssj": "geometry.ab.goku_ssj",
    "ssj3": "geometry.ab.goku_ssj3",
    "ssb": "geometry.ab.goku_ssb",
    "ui": "geometry.ab.goku_ui"
   },
   "animations": {
    "look": "animation.ab.look_at_target",
    "move": "animation.ab.move",
    "idle": "animation.ab.idle",
    "attack": "animation.ab.attack",
    "pose_beam": "animation.ab.pose_beam",
    "pose_cup": "animation.ab.pose_cup",
    "pose_raise": "animation.ab.pose_raise",
    "pose_point": "animation.ab.pose_point"
   },
   "scripts": {
    "animate": [
     "look",
     "move",
     "idle",
     {
      "attack": "variable.attack_time > 0.0"
     },
     {
      "pose_beam": "query.property('ab:pose') == 1"
     },
     {
      "pose_cup": "query.property('ab:pose') == 2"
     },
     {
      "pose_raise": "query.property('ab:pose') == 3"
     },
     {
      "pose_point": "query.property('ab:pose') == 4"
     }
    ]
   },
   "render_controllers": [
    "controller.render.ab.goku"
   ],
   "spawn_egg": {
    "base_color": "#f6801a",
    "overlay_color": "#223aaa"
   }
  }
 }
}