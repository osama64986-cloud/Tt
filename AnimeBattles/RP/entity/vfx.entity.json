    "c3": "textures/entity/vfx/vfx_3",
    "c4": "textures/entity/vfx/vfx_4",
    "c5": "textures/entity/vfx/vfx_5",
    "c6": "textures/entity/vfx/vfx_6",
    "c7": "textures/entity/vfx/vfx_7",
    "c8": "textures/entity/vfx/vfx_8",
    "c9": "textures/entity/vfx/vfx_9",
    "c10": "textures/entity/vfx/vfx_10"
   },
