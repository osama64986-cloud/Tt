{
  "namespace": "server_form",

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§a§l§c§h') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "sh_alchemy_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.sh_alc_form"
                }
              }
            }
          }
        ]
      }
    ]
  },

  "sh_alc_form": {
    "type": "panel",
    "size": [250, 146],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§a§l§c§h') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "sh_bg": { "type": "image", "texture": "textures/ui/dialog_background_opaque", "size": ["100%", "100%"], "layer": 1 } },
      {
        "sh_title": {
          "type": "label",
          "text": "Alchemist",
          "color": [0.3, 0.3, 0.3],
          "shadow": false,
          "offset": [8, 7],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 3
        }
      },
      { "close@common.close_button": {} },
      {
        "sh_content": {
          "type": "panel",
          "size": [234, 119],
          "offset": [8, 20],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 2,
          "controls": [
            {
              "sh_art": {
                "type": "image",
                "texture": "textures/ui/sh_alc_cauldron",
                "size": [56, 48],
                "offset": [6, 0],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 3
              }
            },
            {
              "sh_slots": {
                "type": "grid",
                "collection_name": "form_buttons",
                "grid_dimensions": [6, 1],
                "size": [132, 22],
                "offset": [-64, 52],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 3,
                "controls": [
                  { "sh_water@server_form.sh_alc_slot": { "grid_position": [3, 0], "$sh_ghost": "textures/ui/sh_alc_ghost_water" } },
                  { "sh_flame@server_form.sh_alc_slot": { "grid_position": [4, 0], "$sh_ghost": "textures/ui/sh_alc_ghost_flame" } },
                  { "sh_book@server_form.sh_alc_slot": { "grid_position": [5, 0], "$sh_ghost": "textures/ui/sh_alc_book", "$sh_count": false } }
                ]
              }
            },
            {
              "sh_rows_indent": {
                "type": "image",
                "texture": "textures/ui/cell_image",
                "size": [160, 86],
                "offset": [74, 0],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "layer": 2,
                "controls": [
                  {
                    "sh_rows": {
                      "type": "grid",
                      "collection_name": "form_buttons",
                      "grid_dimensions": [1, 3],
                      "size": [158, 84],
                      "offset": [1, 1],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "layer": 3,
                      "controls": [
                        { "sh_row_1@server_form.sh_alc_row": { "grid_position": [0, 0] } },
                        { "sh_row_2@server_form.sh_alc_row": { "grid_position": [0, 1] } },
                        { "sh_row_3@server_form.sh_alc_row": { "grid_position": [0, 2] } }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "sh_status": {
                "type": "image",
                "texture": "textures/ui/enchanting_dark_background",
                "size": ["100%", 27],
                "offset": [0, 0],
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "layer": 2,
                "controls": [
                  {
                    "sh_status_text": {
                      "type": "label",
                      "text": "#form_text",
                      "size": ["100% - 8px", "default"],
                      "offset": [4, 0],
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "color": [1, 1, 1],
                      "shadow": true,
                      "layer": 3
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "sh_alc_row_bg": {
    "type": "panel",
    "size": ["100%", "100%"],
    "$sh_on_tex|default": "textures/ui/enchanting_active_background",
    "controls": [
      {
        "sh_on": {
          "type": "image",
          "texture": "$sh_on_tex",
          "layer": 1,
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "(not ((#form_button_text - '§k§r') = #form_button_text))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "sh_off": {
          "type": "image",
          "texture": "textures/ui/enchanting_dark_background",
          "layer": 1,
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "((#form_button_text - '§k§r') = #form_button_text)", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },

  "sh_alc_row": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "sh_btn@common.button": {
          "size": ["100%", "100% - 1px"],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "$pressed_button_name": "button.form_button_click",
          "layer": 1,
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
          ],
          "controls": [
            { "default@server_form.sh_alc_row_bg": {} },
            { "hover@server_form.sh_alc_row_bg": { "$sh_on_tex": "textures/ui/enchanting_active_background_with_hover_text" } },
            { "pressed": { "type": "image", "texture": "textures/ui/enchanting_dark_background", "layer": 1 } }
          ]
        }
      },
      {
        "sh_icon": {
          "type": "image",
          "size": [16, 16],
          "offset": [5, 0],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "layer": 6,
          "bindings": [
            { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "sh_dim": {
          "type": "image",
          "texture": "textures/ui/White",
          "color": [0, 0, 0],
          "alpha": 0.5,
          "size": [16, 16],
          "offset": [5, 0],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "layer": 7,
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "(not ((#form_button_text - '§o§r') = #form_button_text))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "sh_text": {
          "type": "label",
          "text": "#form_button_text",
          "size": ["100% - 28px", "default"],
          "offset": [25, 0],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "color": [1, 1, 1],
          "shadow": true,
          "layer": 8,
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "((#form_button_text - '§l§r') = #form_button_text)", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "sh_runes": {
          "type": "label",
          "text": "#form_button_text",
          "font_type": "rune",
          "size": ["100% - 12px", "default"],
          "offset": [6, 0],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "color": [0.408, 0.368, 0.29],
          "shadow": false,
          "layer": 8,
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "(not ((#form_button_text - '§l§r') = #form_button_text))", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },

  "sh_alc_slot": {
    "type": "panel",
    "size": [20, 20],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "$sh_ghost|default": "textures/ui/cell_image",
    "$sh_count|default": true,
    "controls": [
      {
        "sh_btn@common.button": {
          "size": ["100%", "100%"],
          "$pressed_button_name": "button.form_button_click",
          "layer": 1,
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "form_buttons" }
          ],
          "controls": [
            { "default": { "type": "image", "texture": "textures/ui/cell_image", "layer": 1 } },
            {
              "hover": {
                "type": "image",
                "texture": "textures/ui/cell_image",
                "layer": 1,
                "controls": [
                  { "sh_hl": { "type": "image", "texture": "textures/ui/White", "alpha": 0.35, "size": ["100% - 2px", "100% - 2px"], "layer": 9 } }
                ]
              }
            },
            { "pressed": { "type": "image", "texture": "textures/ui/cell_image", "layer": 1 } }
          ]
        }
      },
      {
        "sh_ghost": {
          "type": "image",
          "texture": "$sh_ghost",
          "size": [16, 16],
          "layer": 4,
          "bindings": [
            { "binding_name": "#form_button_texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "((#form_button_texture = '') or (not $sh_count))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "sh_item": {
          "type": "image",
          "size": [16, 16],
          "layer": 5,
          "ignored": "(not $sh_count)",
          "bindings": [
            { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" },
            { "binding_type": "view", "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "sh_count": {
          "type": "label",
          "text": "#form_button_text",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [0, 1],
          "color": [1, 1, 1],
          "shadow": true,
          "layer": 6,
          "ignored": "(not $sh_count)",
          "bindings": [
            { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }
          ]
        }
      }
    ]
  }
}
