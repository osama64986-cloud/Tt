{
  "namespace": "hud",

  "sh_player_doll": {
    "type": "panel",
    "size": [ 36, 50 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 2, 2 ],
    "layer": 2,
    "controls": [
      {
        "doll_frame": {
          "type": "image",
          "texture": "textures/ui/sh_hud_portrait",
          "size": [ "100%", "100%" ],
          "layer": 1
        }
      },
      {
        "doll": {
          "type": "custom",
          "renderer": "live_player_renderer",
          "layer": 3,
          "size": [ "100% - 6px", "100% - 7px" ],
          "offset": [ 0, -1 ],
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  "hud_actionbar_text": {
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 39, 2 ],
    "texture": "textures/ui/sh_hud_panel",
    "size": [ "100%c + 16px", "100%c + 9px" ]
  },

  "hud_actionbar_text/actionbar_message": {
    "text_alignment": "left",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 8, 0 ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [ { "sh_doll@hud.sh_player_doll": {} } ]
      }
    ]
  }
}
