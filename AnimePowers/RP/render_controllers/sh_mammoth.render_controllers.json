{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.sh_mammoth": {
   "arrays": {
    "textures": {
     "Array.t": [
      "Texture.default",
      "Texture.hot"
     ]
    }
   },
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Array.t[query.property('sh:hot')]"
   ]
  },
  "controller.render.sh_mantis": {
   "arrays": {
    "textures": {
     "Array.t": [
      "Texture.default",
      "Texture.hot",
      "Texture.camo"
     ]
    },
    "materials": {
     "Array.m": [
      "Material.default",
      "Material.camo"
     ]
    }
   },
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Array.m[query.property('sh:camo')]"
    }
   ],
   "textures": [
    "Array.t[query.property('sh:camo') == 1 ? 2 : query.property('sh:hot')]"
   ]
  }
 }
}