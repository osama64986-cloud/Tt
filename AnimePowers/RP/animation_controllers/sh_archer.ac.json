{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.sh_archer.state": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "rest"
          ],
          "transitions": [
            {
              "aim": "query.property('sh:state') == 3"
            },
            {
              "draw": "query.property('sh:state') == 1"
            },
            {
              "release": "query.property('sh:state') == 2"
            }
          ],
          "blend_transition": 0.2
        },
        "aim": {
          "animations": [
            "aim"
          ],
          "transitions": [
            {
              "draw": "query.property('sh:state') == 1"
            },
            {
              "release": "query.property('sh:state') == 2"
            },
            {
              "default": "query.property('sh:state') == 0"
            }
          ],
          "blend_transition": 0.2
        },
        "draw": {
          "animations": [
            "draw"
          ],
          "transitions": [
            {
              "release": "query.property('sh:state') == 2"
            },
            {
              "aim": "query.property('sh:state') == 3"
            },
            {
              "default": "query.property('sh:state') == 0"
            }
          ],
          "blend_transition": 0.12
        },
        "release": {
          "animations": [
            "release"
          ],
          "transitions": [
            {
              "draw": "query.property('sh:state') == 1"
            },
            {
              "aim": "query.property('sh:state') == 3"
            },
            {
              "default": "query.property('sh:state') == 0"
            }
          ],
          "blend_transition": 0.04
        }
      }
    }
  }
}