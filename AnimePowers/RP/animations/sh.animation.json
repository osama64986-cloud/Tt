{
  "format_version": "1.8.0",
  "animations": {
    "animation.sh.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.sh_trainer.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            0,
            "math.sin(query.life_time*90)*0.15",
            0
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time*70)*2",
            "math.sin(query.life_time*35)*8",
            0
          ]
        },
        "arm_l": {
          "rotation": [
            "math.sin(query.life_time*90)*2",
            0,
            "-2 - math.sin(query.life_time*90)*1.5"
