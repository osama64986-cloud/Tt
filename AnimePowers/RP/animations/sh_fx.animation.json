      0
     ]
    },
    "jaw_l": {
     "rotation": [
      "math.max(0, 38 - q.life_time * 230)",
      0,
      0
     ]
    }
   }
  },
  "animation.sh_fx.shape_rift": {
   "loop": true,
   "bones": {
    "tilt": {
